# Database & Cache Settings
DATABASE_URL=postgresql://pursuit:pursuit@localhost:5432/pursuit
REDIS_URL=redis://localhost:6379

# Authentication Settings (JWT secrets should be at least 16 chars)
JWT_SECRET=changeme_at_least_16_chars
JWT_REFRESH_SECRET=changeme_at_least_16_chars

# LLM Provider Configuration (e.g. Anthropic, OpenAI, Groq, Ollama)
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000

# Embedding Configuration
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Object Storage Settings (Optional S3-Compatible)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=

# General App Configuration
CLIENT_URL=http://localhost:5173
PORT=3001
REMINDER_DAYS_THRESHOLD=7
