# Database & Cache Settings
DATABASE_URL=postgresql://pursuit:pursuit@localhost:5434/pursuit
REDIS_URL=redis://localhost:6381

# Authentication Settings (JWT secrets should be at least 16 chars)
JWT_SECRET=changeme_at_least_16_chars
JWT_REFRESH_SECRET=changeme_at_least_16_chars

# LLM Provider Configuration (Groq — OpenAI-compatible API, free at console.groq.com)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Optional: comma-separated list of keys to rotate through on 429 rate limits (LLM_API_KEY still used as the single fallback if unset)
LLM_API_KEYS=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=2000

# Embedding Configuration (Using GitHub Models for free 1536-dim embeddings)
# Requires a GitHub Personal Access Token (PAT) set in EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://models.github.ai/inference
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Cloudinary Settings (Optional - for PDF uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Job Discovery (TinyFish - free at tinyfish.ai, no credit card required)
# Sign up at https://tinyfish.ai to get your API key
TINYFISH_API_KEY=

# Job Discovery - Adzuna aggregator (Optional - free at developer.adzuna.com, 250 req/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# General App Configuration
CLIENT_URL=http://localhost:5173
PORT=3001
REMINDER_DAYS_THRESHOLD=7
